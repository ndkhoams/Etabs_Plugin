<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <PublishDir>bin\$(Configuration)\publish\</PublishDir>
    <PluginBuildTimestamp Condition="'$(PluginBuildTimestamp)' == ''">$([System.DateTime]::UtcNow.AddHours(7).ToString('yyyyMMdd-HHmmss'))</PluginBuildTimestamp>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="PluginBuildTimestamp" Value="$(PluginBuildTimestamp)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ETABSv1">
      <HintPath>C:\Program Files\Computers and Structures\ETABS 22\ETABSv1.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.102.2" />
  </ItemGroup>

  <!-- Mỗi lần build, tự xuất version.txt (chứa đúng dấu build đã đóng vào DLL)
       ngay cạnh DLL trong thư mục output, để khi đóng gói ISO chỉ việc nhặt kèm
       file này vào thư mục gốc của ISO. Tab Check for Updates đọc nó để so phiên bản. -->
  <Target Name="WritePluginVersionFile" AfterTargets="Build">
    <WriteLinesToFile File="$(TargetDir)version.txt" Lines="$(PluginBuildTimestamp)" Overwrite="true" Encoding="UTF-8" />
  </Target>

  <!-- Dấu build KHÔNG còn ghi vào file nguồn (từng gây "Cannot pull" sau mỗi
       lần build): target này sinh file BuildStamp.g.cs trong obj/ (gitignore)
       chứa đúng khai báo currentBuild cũ, code dùng nó không đổi gì. -->
  <Target Name="StampPluginBuildTimestamp" BeforeTargets="CoreCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildStamp.g.cs" Lines="namespace Etabs_Ultimate_Tools { public partial class ModelCheckForm { private const string currentBuild = &quot;$(PluginBuildTimestamp)&quot;%3B } }" Overwrite="true" Encoding="UTF-8" />
  </Target>

  <ItemGroup>
    <Compile Include="$(IntermediateOutputPath)BuildStamp.g.cs" />
  </ItemGroup>
</Project>

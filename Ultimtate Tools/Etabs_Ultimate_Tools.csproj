<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <PublishDir>bin\$(Configuration)\publish\</PublishDir>
    <PluginBuildTimestamp Condition="'$(PluginBuildTimestamp)' == ''">$([System.DateTime]::UtcNow.AddHours(7).ToString('yyyyMMdd-HHmmss'))</PluginBuildTimestamp>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="PluginBuildTimestamp" Value="$(PluginBuildTimestamp)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ETABSv1">
      <HintPath>C:\Program Files\Computers and Structures\ETABS 22\ETABSv1.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <!-- Load Assigner (toi uu doc Excel 2026-11-08): Detector doc ten sheet truc
         tiep tu xl/workbook.xml trong file zip — can System.IO.Compression. -->
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.102.2" />
    <!-- Load Assigner (gop 2026-11-08): Profile luu/tai JSON dung System.Text.Json. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- Mỗi lần build, tự xuất version.txt (chứa đúng dấu build đã đóng vào DLL)
       ngay cạnh DLL trong thư mục output, để khi đóng gói ISO chỉ việc nhặt kèm
       file này vào thư mục gốc của ISO. Tab Check for Updates đọc nó để so phiên bản. -->
  <Target Name="WritePluginVersionFile" AfterTargets="Build">
    <WriteLinesToFile File="$(TargetDir)version.txt" Lines="$(PluginBuildTimestamp)" Overwrite="true" Encoding="UTF-8" />
  </Target>

  <!-- Dấu build (giong CADtools, user chot 09/11): BuildTimestamp la hang
       trong ModelCheckForm.Update.cs — target nay dong dau moi lan build
       (ghi de gia tri cu bang PluginBuildTimestamp). Title bar hien dung
       hang nay, tab Check for Updates lay gia tri moi nhat tu chinh file
       nay tren GitHub. Luu y: build se lam ban file nguon (nhu ben
       CADtools) — commit kem khi phat hanh ban moi. -->
  <UsingTask TaskName="UpdateBuildTimestamp" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceFile ParameterType="System.String" Required="true" />
      <NewTimestamp ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          string source = System.IO.File.ReadAllText(SourceFile);
          string pattern = "(?m)(?<prefix>private const string BuildTimestamp = \")[0-9]{8}-[0-9]{6}(?<suffix>\";)";
          System.Text.RegularExpressions.Match match = System.Text.RegularExpressions.Regex.Match(source, pattern);
          if (!match.Success)
            throw new System.InvalidOperationException("Expected exactly one BuildTimestamp constant in '" + SourceFile + "'.");
          string updated = System.Text.RegularExpressions.Regex.Replace(source, pattern, "${prefix}" + NewTimestamp + "${suffix}");
          if (updated != source)
            System.IO.File.WriteAllText(SourceFile, updated, new System.Text.UTF8Encoding(false));
        ]]>
      </Code>
    </Task>
  </UsingTask>
  <Target Name="UpdateBuildTimestamp" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <UpdateBuildTimestamp SourceFile="$(MSBuildProjectDirectory)\ModelCheckForm.Update.cs" NewTimestamp="$(PluginBuildTimestamp)" />
  </Target>
</Project>
